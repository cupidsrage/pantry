ANTHROPIC_API_KEY=sk-ant-...

# Optional: persistent storage path inside a Railway volume
# DB_PATH=/data/pantry.db

# Optional: push reminders ("start cooking" / "take it out to thaw").
# Generate a keypair with `npm run vapid` and paste the output here.
# Without these the reminders are simply off and the toggle stays hidden.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Optional: link-fetching from sites that block bots (allrecipes, NYT Cooking, etc.).
# The app fetches directly first (free) and only uses the scraper when blocked.
#
# Simplest — ScraperAPI (permanent free tier: 1,000 requests/month):
#   SCRAPER_KEY=your_key
#
# Any other provider — set a URL template with {url} and optional {key}:
#   SCRAPER_KEY=your_key
#   SCRAPER_URL=https://app.scrapingbee.com/api/v1/?api_key={key}&url={url}
